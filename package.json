{
  "name": "lifetime",
  "version": "2.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "check": "npm run check:sdk && npm run check:routes && npm run check:intl && npm run check:domain && npm run typecheck && npm run test",
    "check:sdk": "node scripts/check-sdk-versions.mjs",
    "testflight": "bundle exec fastlane ios beta",
    "signing:dev": "bundle exec fastlane ios development",
    "ios:device": "expo run:ios --device",
    "ios:reset": "expo prebuild --platform ios --clean",
    "ios:device:release": "expo run:ios --device --configuration Release",
    "check:routes": "node scripts/check-routes.mjs",
    "check:intl": "node scripts/check-intl.mjs",
    "preview": "node scripts/preview.mjs",
    "check:domain": "node scripts/check-domain.mjs"
  },
  "dependencies": {
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-glass-effect": "~58.0.5",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.0.0",
    "playwright": "^1.50.0",
    "ts-jest": "^29.4.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  }
}
